APP_NAME=PR_app
APP_ENV=local
APP_KEY=            # generate with: php artisan key:generate
APP_DEBUG=true      
APP_URL=http://localhost:8055
FRONTEND_URL=http://localhost:8055
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MySQL). В Docker хост = имя сервиса из docker-compose (db)
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions / Sanctum (SPA auth). Фронт и API на одном адресе через nginx
SESSION_DRIVER=file
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:8055

QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# OpenAI (used by the Discord arbitration helper)
OPENAI_API_KEY=

# WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Сервер Laravel -> Reverb внутри Docker-сети
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http

# Сам Reverb слушает все интерфейсы контейнера
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# Браузер -> Reverb через nginx (location /app)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8055
VITE_REVERB_SCHEME=http

# Only for `php artisan db:seed` (local development)
SEED_ADMIN_PASSWORD=
