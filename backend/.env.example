APP_NAME=PR_app
APP_ENV=local
APP_KEY=            # generate with: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8055
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pr_searching
DB_USERNAME=pr_user
DB_PASSWORD=

# Sessions / Sanctum (SPA auth)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:3000

QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# OpenAI (used by the Discord arbitration helper)
OPENAI_API_KEY=

# WebSockets (Laravel Reverb)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Only for `php artisan db:seed` (local development)
SEED_ADMIN_PASSWORD=
